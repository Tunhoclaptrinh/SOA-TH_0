# Sao chép thành .env; các entrypoint tự nạp bằng dotenv.
# Biến đã export trong terminal được ưu tiên hơn .env.
BANK_URL=http://localhost:4002
FEE_PORT=4001
BANK_PORT=4002
DELAY_MS=0
FAIL_RATE=0
DROP_RATE=0

# Fee Service: giữ mặc định để đạt giới hạn thời gian của đề.
PAYMENT_TIMEOUT_MS=4000
ATTEMPT_TIMEOUT_MS=1200
CONNECT_TIMEOUT_MS=700
MAX_ATTEMPTS=4
KEEP_ALIVE=true

# Benchmark
FEE_URL=http://localhost:4001
AMOUNT=1000
